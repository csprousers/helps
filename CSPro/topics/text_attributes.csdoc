    <cell><link question_text_file_qsf.csdoc>Question text</link></cell><cell>UTF-8</cell><cell>UTF-8 (BOM)</cell><cell>&mdash;</cell>
    <cell><link message_file_mgf.csdoc>User-defined messages</link></cell><cell>UTF-8</cell><cell>UTF-8 (BOM)</cell><cell>&mdash;</cell>
    <cell><link listing_file.csdoc>Listing files</link></cell><cell>&mdash;</cell><cell>UTF-8 (BOM)</cell><cell>🔜</cell>
